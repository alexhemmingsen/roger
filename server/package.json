{
  "name": "roger-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --linked --schema public > src/database.types.ts && pnpm dlx prettier@3 --write src/database.types.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.13",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
