PORT=3000

# Supabase dashboard -> Project Settings -> Data API (URL) and API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only, never put it in the app.
SUPABASE_SECRET_KEY=sb_secret_...
# Used to verify the app's login tokens.
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Speech-to-text and the assistant. Without it, both return stub text.
OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-6.1-sol.
OPENAI_MODEL=gpt-6.1-sol
